<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UMiiSharp</RootNamespace>
    <AssemblyName>UMiiSharp</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>Aiden A</Authors>
    <Description>Reader/Writer for the UMii character files of Breath of the Wild (.bumii) and Tears of the Kingdom (UMiiParam).</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\AampSharp\src\AampSharp\AampSharp.csproj" />
    <ProjectReference Include="..\..\..\BymlSharp\src\BymlSharp\BymlSharp.csproj" />
  </ItemGroup>

</Project>
